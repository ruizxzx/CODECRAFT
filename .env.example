# ===================================================
# KRISHFICIENT - Production Environment Variables
# For Vercel Deployment & Local Development
# ===================================================

# Firebase Web Client Configuration (Public Vite Variables)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Do not set VITE_FIREBASE_DATABASE_ID. This application uses Firestore's
# default database in the krishficient-portfolio Firebase project.

# OFFSCRPT Media Storage (Cloudflare R2) - server-side only; NEVER prefix these with VITE_
R2_ACCOUNT_ID=""
R2_BUCKET_NAME="offscrpt-media"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_PUBLIC_BASE_URL="https://media.example.com"
OFFSCRPT_ADMIN_EMAILS="ruizxzxz@gmail.com,krishsarkar456@gmail.com"
OFFSCRPT_MAX_IMAGE_BYTES="10485760"
OFFSCRPT_MAX_VIDEO_BYTES="262144000"
OFFSCRPT_MAX_FILE_BYTES="26214400"

# Server-only discussion intelligence
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
