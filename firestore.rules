rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Google-authenticated owners only. This is enforced by Firestore itself;
    // the client-side admin UI check is only a convenience, not authorization.
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.get('email_verified', false) == true &&
        request.auth.token.get('email', '') in ['ruizxzxz@gmail.com', 'krishsarkar456@gmail.com']
      ); 
    }
    function isPlatformModerator() { return isSignedIn() && exists(/databases/$(database)/documents/siteModerators/$(request.auth.uid)); }
    function isStaff() { return isAdmin() || isPlatformModerator(); }
    function siteConfigExists() { return exists(/databases/$(database)/documents/siteConfig/global); }
    function publicBlogsEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('allowPublicBlogs', true) == true; }
    function communityBlogsEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('allowCommunityBlogs', true) == true; }
    function communityDiscussionsEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('allowCommunityDiscussions', true) == true; }
    function communityCreationEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('allowCommunityCreation', true) == true; }
    function communityPostsEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('allowCommunityPosts', true) == true; }
    function questionsEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('allowQuestions', true) == true; }
    function topicsEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('allowTopics', true) == true; }
    function directMessagesEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('allowDirectMessages', true) == true; }

    // USER VALIDATION
    function isValidUser(data) {
      return data.keys().hasAll(["uid", "username", "displayName", "createdAt", "updatedAt"])
        && data.uid is string && data.uid.size() <= 128
        && data.username is string && data.username.size() <= 32 && data.username.matches('^[a-zA-Z0-9_]+$')
        && data.displayName is string && data.displayName.size() <= 64
        && data.get('photoURL', '') is string && data.get('photoURL', '').size() <= 2048
        && data.get('coverImageUrl', '') is string && data.get('coverImageUrl', '').size() <= 2048
        && data.get('websiteUrl', '') is string && data.get('websiteUrl', '').size() <= 512
        && data.get('location', '') is string && data.get('location', '').size() <= 100
        && data.get('socialX', '') is string && data.get('socialX', '').size() <= 512
        && data.get('socialGithub', '') is string && data.get('socialGithub', '').size() <= 512
        && data.get('socialTelegram', '') is string && data.get('socialTelegram', '').size() <= 512
        && data.get('socialInstagram', '') is string && data.get('socialInstagram', '').size() <= 512
        && data.get('bio', '') is string && data.get('bio', '').size() <= 500
        && data.get('themeColor', '#000000') is string && data.get('themeColor', '#000000').size() <= 7 && data.get('themeColor', '#000000').matches('^#[0-9a-fA-F]{6}$')
        && data.get('followersCount', 0) is number
        && data.get('followingCount', 0) is number
        && data.get('role', '') is string
        && data.get('platformRole', 'member') in ['member','moderator','master_admin']
        && data.get('isAuthor', false) is bool
        && data.get('isVerified', false) is bool
        && data.get('verificationColor', '#2196F3') is string && data.get('verificationColor', '#2196F3').matches('^#[0-9a-fA-F]{6}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /siteModerators/{userId} {
      // A moderator must be able to verify their own staff membership.
      // Nobody else gets to enumerate the moderator registry.
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() 
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().get('platformRole', 'member') == (isAdmin() ? 'master_admin' : 'member')
        && incoming().get('role', '') == (isAdmin() ? 'Master Admin' : '')
        && existsAfter(/databases/$(database)/documents/usernames/$(incoming().username));
      allow update: if (isSignedIn()
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().username == existing().username
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().get('isBlocked', false) == existing().get('isBlocked', false)
        && incoming().get('isVerified', false) == existing().get('isVerified', false)
        && incoming().get('verificationColor', '#2196F3') == existing().get('verificationColor', '#2196F3')
        && incoming().get('isAuthor', false) == existing().get('isAuthor', false)
        && incoming().get('role', '') == existing().get('role', '')
        && incoming().get('platformRole', 'member') == existing().get('platformRole', 'member')
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'coverImageUrl', 'websiteUrl', 'location', 'socialX', 'socialGithub', 'socialTelegram', 'socialInstagram', 'bio', 'themeColor', 'creatorPage', 'updatedAt']))
        || (isAdmin() && request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'coverImageUrl', 'websiteUrl', 'location', 'socialX', 'socialGithub', 'socialTelegram', 'socialInstagram', 'bio', 'themeColor', 'creatorPage', 'role', 'platformRole', 'isAuthor', 'isVerified', 'verificationColor', 'updatedAt']))
        || (isAdmin() && existing().username == 'krishsarkar' && existing().get('isAuthor', false) == true && incoming().uid == existing().uid && incoming().username == existing().username && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'coverImageUrl', 'websiteUrl', 'location', 'socialX', 'socialGithub', 'socialTelegram', 'socialInstagram', 'bio', 'themeColor', 'creatorPage', 'role', 'platformRole', 'isAuthor', 'isVerified', 'verificationColor', 'followersCount', 'followingCount', 'updatedAt']))
        || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isBlocked', 'updatedAt']))
        || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isVerified', 'verificationColor', 'updatedAt'])) || (isPlatformModerator() && incoming().diff(existing()).affectedKeys().hasOnly(['content','updatedAt']))
        || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt']))
        || (isSignedIn() && request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['followingCount', 'updatedAt']))
        || (isAdmin() && isValidUser(incoming()));
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      match /followers/{followerId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.auth.uid == followerId
          && incoming().keys().hasAll(["createdAt", "uid", "username"])
          && incoming().uid == followerId;
        allow delete: if isSignedIn() && request.auth.uid == followerId;
      }

      match /following/{followingId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && incoming().keys().hasAll(["createdAt", "uid", "username"])
          && incoming().uid == followingId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /followedTopics/{topicId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && request.auth.uid == userId
          && incoming().topic is string && incoming().topic.size() >= 2 && incoming().topic.size() <= 64
          && incoming().createdAt is timestamp;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /saves/{saveId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && incoming().keys().hasAll(["itemId", "itemType", "createdAt"])
          && incoming().itemId is string && incoming().itemId.size() <= 128
          && incoming().itemType in ['article', 'post']
          && incoming().createdAt is timestamp;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /history/{historyId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && incoming().slug is string
          && incoming().slug.size() <= 512
          && incoming().title is string
          && incoming().title.size() <= 300
          && incoming().get('progress', 0) is number
          && incoming().get('viewedAt', request.time) is timestamp
        && incoming().get('lastSection', '') is string && incoming().get('lastSection', '').size() <= 200
        && incoming().get('scrollY', 0) is number && incoming().get('scrollY', 0) >= 0
        && incoming().get('viewportHeight', 0) is number && incoming().get('viewportHeight', 0) >= 0 && incoming().get('viewportHeight', 0) <= 20000
        && incoming().get('device', '') is string && incoming().get('device', '').size() <= 120
        && incoming().get('source', 'article') is string && incoming().get('source', 'article').size() <= 80;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Private, account-scoped reading queue. Deterministic document IDs prevent duplicates.
      match /readingQueue/{queueId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && incoming().itemId is string && incoming().itemId.size() <= 512
          && incoming().itemType in ['article', 'post']
          && incoming().title is string && incoming().title.size() <= 300
          && incoming().createdAt is timestamp;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Private account preferences. Only the owning account can read/write these.
      match /preferences/{preferenceId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && request.auth.uid == userId && (
          (preferenceId == 'notifications'
            && incoming().get('comments', true) is bool
            && incoming().get('replies', true) is bool
            && incoming().get('mentions', true) is bool
            && incoming().get('follows', true) is bool
            && incoming().get('reactions', true) is bool
            && incoming().get('productNews', true) is bool)
          || (preferenceId == 'ui' && incoming().get('theme', 'light') in ['light','dark'])
        );
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /upvotes/{postId} {
        allow read: if true;
        allow create, update: if isSignedIn() && request.auth.uid == userId && incoming().postId == postId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /reposts/{postId} {
        allow read: if true;
        allow create, update: if isSignedIn() && request.auth.uid == userId && incoming().postId == postId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }


    // SOCIAL 3.0: unified communities, questions, topics, messaging and moderation.
    function validText(v, max) { return v is string && v.size() <= max; }
    function isCommunityOwner(communityId) {
      return isSignedIn() && get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid;
    }
    function isCommunityModerator(communityId) {
      return isSignedIn() && get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.get('role','member') in ['owner','moderator'];
    }

    match /communities/{communityId} {
      allow read: if true;
      allow create: if isSignedIn() && (isAdmin() || isPlatformModerator() || communityCreationEnabled())
        && incoming().ownerId == request.auth.uid
        && incoming().membersCount == 1
        && incoming().postsCount == 0
        && validText(incoming().name, 60)
        && validText(incoming().slug, 60)
        && validText(incoming().description, 1000);
      allow update: if isSignedIn() && (
        isAdmin() || isPlatformModerator() ||
        (existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId && incoming().diff(existing()).affectedKeys().hasOnly(['name','slug','description','iconUrl','bannerUrl','rules','ownerUsername','ownerName','ownerAvatar','isPrivate','isArchived','isLocked','allowLinks','allowMedia','defaultPostType','updatedAt'])) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['membersCount','updatedAt']) && incoming().membersCount >= 0) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['postsCount','updatedAt']) && incoming().postsCount >= 0) ||
        (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['ownerId','ownerUsername','ownerName','ownerAvatar','updatedAt']))
      );
      allow delete: if isSignedIn() && (isAdmin() || isPlatformModerator() || existing().ownerId == request.auth.uid);

      match /members/{memberId} {
        allow read: if true;
        allow create: if isSignedIn() && (request.auth.uid == memberId || isAdmin() || isPlatformModerator() || isCommunityOwner(communityId))
          && incoming().uid == memberId;
        allow update: if isSignedIn() && (
          isAdmin() ||
          isCommunityOwner(communityId) ||
          (isPlatformModerator() && memberId != get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId)
        );
        allow delete: if isSignedIn() && (
          isAdmin() ||
          (isCommunityOwner(communityId) && memberId != get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId) ||
          (isPlatformModerator() && memberId != get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId) ||
          (request.auth.uid == memberId && memberId != get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId)
        );
      }

      match /posts/{postId}/{nestedPath=**} {
        allow read: if true;
        allow delete: if isSignedIn() && (isAdmin() || isPlatformModerator() || isCommunityModerator(communityId) || request.auth.uid == get(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)).data.authorId);
      }

      match /posts/{postId} {
        allow read: if true;
        allow create: if isSignedIn() && (isAdmin() || isPlatformModerator() || communityPostsEnabled())
          && incoming().authorId == request.auth.uid
          && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid))
          && validText(incoming().title, 256)
          && validText(incoming().content, 100000)
          && incoming().score == 0
          && incoming().commentsCount == 0
          && incoming().get('isFeatured', false) == false
          && (incoming().get('postType', 'discussion') == 'blog' ? communityBlogsEnabled() : communityDiscussionsEnabled());
        allow update: if isSignedIn() && (
          isAdmin() ||
          isPlatformModerator() ||
          isCommunityModerator(communityId) ||
          (request.auth.uid == existing().authorId && (
            existing().get('postType', 'discussion') != 'blog' ||
            (existing().get('promotedToArticleSlug', '') == '' && existing().get('mainPublicationStatus', '') != 'published') ||
            (incoming().get('editReviewStatus', '') == 'pending' && incoming().get('editReviewRequestedAt', null) is timestamp && incoming().get('editReviewedAt', null) == null && incoming().get('editReviewedBy', null) == null)
          ))
        );
        allow update: if !isSignedIn()
          && incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount','updatedAt'])
          && incoming().get('viewsCount', 0) == existing().get('viewsCount', 0) + 1
          && incoming().updatedAt is timestamp;
        allow delete: if isSignedIn() && (isAdmin() || isPlatformModerator() || isCommunityModerator(communityId) || request.auth.uid == existing().authorId);
        match /views/{viewId} {
          allow read: if isAdmin();
          allow create: if incoming().postId == postId
            && incoming().day is string
            && incoming().createdAt is timestamp
            && ((isSignedIn() && incoming().get('userId','') == request.auth.uid) || (!isSignedIn() && incoming().get('visitorId','') is string));
          allow update, delete: if isAdmin();
        }
        match /votes/{userId} {
          allow read: if true;
          allow create, update: if isSignedIn() && request.auth.uid == userId && incoming().uid == request.auth.uid && incoming().type in ['up','down'];
          allow delete: if isSignedIn() && (request.auth.uid == userId || isStaff() || isCommunityModerator(communityId));
        }
        match /pollVotes/{userId} {
          allow read: if true;
          allow create, update: if isSignedIn() && request.auth.uid == userId && incoming().uid == request.auth.uid && incoming().optionIndex is number;
          allow delete: if isSignedIn() && (request.auth.uid == userId || isStaff() || isCommunityModerator(communityId));
        }
      }
    }

    match /questions/{questionId} {
      allow read: if true;
      allow create: if isSignedIn() && (isAdmin() || isPlatformModerator() || questionsEnabled()) && incoming().authorId == request.auth.uid && validText(incoming().title,256) && validText(incoming().details,100000) && incoming().answersCount == 0;
      allow update: if isSignedIn() && (isAdmin() || isPlatformModerator() || request.auth.uid == existing().authorId);
      allow delete: if isSignedIn() && (isAdmin() || isPlatformModerator() || request.auth.uid == existing().authorId);
      match /answers/{answerId} {
        allow read: if true;
        allow create: if isSignedIn() && incoming().authorId == request.auth.uid && validText(incoming().content,100000);
        allow update: if isSignedIn() && (isAdmin() || isPlatformModerator() || request.auth.uid == existing().authorId || request.auth.uid == get(/databases/$(database)/documents/questions/$(questionId)).data.authorId);
        allow delete: if isSignedIn() && (isAdmin() || isPlatformModerator() || request.auth.uid == existing().authorId || request.auth.uid == get(/databases/$(database)/documents/questions/$(questionId)).data.authorId);
      }
      match /votes/{userId} {
        allow read: if true;
        allow create, update: if isSignedIn() && request.auth.uid == userId && incoming().type in ['up','down'];
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
      match /followers/{userId} {
        allow read: if true;
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /topics/{topicId} {
      allow read: if true;
      allow create: if isSignedIn() && (isAdmin() || isPlatformModerator() || topicsEnabled()) && incoming().createdBy == request.auth.uid && validText(incoming().name,80) && validText(incoming().slug,80);
      allow update: if isSignedIn() && (isAdmin() || isPlatformModerator() || request.auth.uid == existing().createdBy || incoming().diff(existing()).affectedKeys().hasOnly(['followersCount','updatedAt']));
      allow delete: if isSignedIn() && (isAdmin() || isPlatformModerator() || request.auth.uid == existing().createdBy);
      match /followers/{userId} {
        allow read: if true;
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /messages/{messageId} {
      allow read: if isAdmin() || (isSignedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.recipientId || request.auth.uid in resource.data.get('participants', [])));
      allow create: if isSignedIn() && (isAdmin() || isPlatformModerator() || directMessagesEnabled()) && request.auth.uid == incoming().senderId && request.auth.uid in incoming().participants && incoming().recipientId in incoming().participants && validText(incoming().content,5000);
      allow update: if isAdmin() || (isSignedIn() && (request.auth.uid == existing().senderId || request.auth.uid == existing().recipientId) && incoming().diff(existing()).affectedKeys().hasOnly(['content','read']));
      allow delete: if isAdmin() || (isSignedIn() && (request.auth.uid == existing().senderId || request.auth.uid == existing().recipientId));
    }

    match /reports/{reportId} {
      allow read: if isStaff();
      allow create: if isSignedIn() && incoming().reporterId == request.auth.uid && validText(incoming().reason,500) && incoming().status == 'open';
      allow update, delete: if isStaff();
    }

    match /admin_notifications/{notificationId} {
      allow read: if isStaff();
      allow create: if isSignedIn()
        && incoming().actorId == request.auth.uid
        && incoming().message is string && incoming().message.size() <= 500
        && incoming().read is bool
        && incoming().createdAt is timestamp;
      allow update, delete: if isAdmin() || isPlatformModerator();
    }

    match /users/{userId}/mutes/{targetUid} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/collections/{collectionId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 50
        && incoming().get('description', '') is string && incoming().get('description', '').size() <= 160
        && incoming().createdAt is timestamp && incoming().updatedAt is timestamp;
      allow update: if isSignedIn() && request.auth.uid == userId
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 50
        && incoming().get('description', '') is string && incoming().get('description', '').size() <= 160
        && incoming().createdAt == existing().createdAt && incoming().updatedAt is timestamp;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.resource.data.actorId is string
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.type is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 200
        && request.resource.data.read is bool
        && request.resource.data.createdAt is timestamp;
    }

    match /users/{userId}/drafts/{draftId} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /usernames/{username} {
      allow read: if true;
      allow update: if isSignedIn() && existing().uid == request.auth.uid && incoming().uid == request.auth.uid;
      allow create: if isSignedIn()
        && incoming().keys().hasAll(["uid"]) && incoming().keys().size() == 1
        && incoming().uid is string && incoming().uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Private resume point for an authenticated reader. This is deliberately
    // separate from a community profile, so Google accounts do not need to
    // claim a username before Continue Reading works.
    match /reading_progress/{userId} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Device-independent article reading checkpoints. One document per article per user.
    match /users/{userId}/readingProgress/{articleSlug} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId
        && incoming().slug == articleSlug
        && incoming().percent is number && incoming().percent >= 0 && incoming().percent <= 100
        && incoming().completed is bool
        && incoming().updatedAt is timestamp
        && incoming().get('lastSection', '') is string && incoming().get('lastSection', '').size() <= 200
        && incoming().get('scrollY', 0) is number && incoming().get('scrollY', 0) >= 0
        && incoming().get('viewportHeight', 0) is number && incoming().get('viewportHeight', 0) >= 0 && incoming().get('viewportHeight', 0) <= 20000
        && incoming().get('device', '') is string && incoming().get('device', '').size() <= 120
        && incoming().get('source', 'article') is string && incoming().get('source', 'article').size() <= 80
        && incoming().get('seriesId', '') is string && incoming().get('seriesId', '').size() <= 200
        && incoming().get('seriesOrder', 0) is number;
      allow update: if isSignedIn() && request.auth.uid == userId
        && incoming().slug == existing().slug
        && incoming().percent is number && incoming().percent >= 0 && incoming().percent <= 100
        && incoming().completed is bool
        && !(existing().completed == true && incoming().completed == false)
        && incoming().updatedAt is timestamp
        && incoming().diff(existing()).affectedKeys().hasOnly(['slug','percent','completed','lastSection','scrollY','viewportHeight','device','source','seriesId','seriesOrder','updatedAt']);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // POST VALIDATION
    function isValidPost(data) {
      return data.keys().hasAll(["type", "title", "content", "authorId", "authorUsername", "upvotesCount", "downvotesCount", "commentsCount", "createdAt", "updatedAt"])
        && data.type is string && (data.type == 'discussion' || data.type == 'blog')
        && data.title is string && data.title.size() <= 256
        && data.content is string && data.content.size() <= 100000
        && data.authorId is string && data.authorId.size() <= 128
        && data.authorUsername is string && data.authorUsername.size() <= 32
        && data.get('authorName', '') is string && data.get('authorName', '').size() <= 64
        && data.get('authorAvatar', '') is string && data.get('authorAvatar', '').size() <= 2048
        && data.get('isVerified', false) is bool
        && data.get('verificationColor', '#2196F3') is string && data.get('verificationColor', '#2196F3').matches('^#[0-9a-fA-F]{6}$')
        && data.upvotesCount is number
        && data.downvotesCount is number
        && data.commentsCount is number
        && data.get('viewsCount', 0) is number
        && data.get('isFeatured', false) is bool
        && data.get('repostsCount', 0) is number
        && data.get('hashtags', []) is list
        && data.get('hashtags', []).size() <= 20
        && data.get('mediaUrls', []) is list
        && data.get('mediaUrls', []).size() <= 6
        && data.get('excerpt', '') is string && data.get('excerpt', '').size() <= 500
        && data.get('coverImage', '') is string && data.get('coverImage', '').size() <= 2048
        && data.get('coverImageAlt', '') is string && data.get('coverImageAlt', '').size() <= 200
        && data.get('coverImageCaption', '') is string && data.get('coverImageCaption', '').size() <= 300
        && data.get('category', '') is string && data.get('category', '').size() <= 80
        && data.get('tags', []) is list && data.get('tags', []).size() <= 20
        && data.get('contentBlocks', []) is list && data.get('contentBlocks', []).size() <= 100
        && data.get('readingTimeMinutes', 1) is number && data.get('readingTimeMinutes', 1) >= 1 && data.get('readingTimeMinutes', 1) <= 180
        && data.get('promotedToArticleSlug', '') is string && data.get('promotedToArticleSlug', '').size() <= 150
        && (data.get('editedAt', null) == null || data.get('editedAt', null) is timestamp)
        && data.get('editReviewStatus', 'approved') in ['pending', 'approved']
        && (data.get('editReviewRequestedAt', null) == null || data.get('editReviewRequestedAt', null) is timestamp)
        && (data.get('editReviewedAt', null) == null || data.get('editReviewedAt', null) is timestamp)
        && (data.get('editReviewedBy', null) == null || (data.get('editReviewedBy', '') is string && data.get('editReviewedBy', '').size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(postId)
        && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBlocked', false)
        && isValidPost(incoming())
        && incoming().authorId == request.auth.uid
        && (incoming().type == 'blog' ? publicBlogsEnabled() : communityDiscussionsEnabled())
        && incoming().upvotesCount == 0
        && incoming().downvotesCount == 0
        && incoming().commentsCount == 0
        && incoming().get('isFeatured', false) == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if (isSignedIn()
        && isValidPost(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || isPlatformModerator()
          || (request.auth.uid == existing().authorId
              && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'hashtags', 'mentionedUsernames', 'mediaUrls', 'excerpt', 'coverImage', 'coverImageAlt', 'coverImageCaption', 'category', 'tags', 'readingTimeMinutes', 'contentBlocks', 'seriesId', 'seriesName', 'seriesOrder', 'editedAt', 'updatedAt'])
              && existing().get('promotedToArticleSlug', '') == ''
              && existing().get('mainPublicationStatus', '') != 'published')
          || (request.auth.uid == existing().authorId
              && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'hashtags', 'mentionedUsernames', 'mediaUrls', 'excerpt', 'coverImage', 'coverImageAlt', 'coverImageCaption', 'category', 'tags', 'readingTimeMinutes', 'contentBlocks', 'seriesId', 'seriesName', 'seriesOrder', 'editedAt', 'updatedAt', 'editReviewStatus', 'editReviewRequestedAt', 'editReviewedAt', 'editReviewedBy'])
              && (existing().get('promotedToArticleSlug', '') != '' || existing().get('mainPublicationStatus', '') == 'published')
              && incoming().get('editReviewStatus', '') == 'pending'
              && incoming().get('editReviewRequestedAt', null) is timestamp
              && incoming().get('editReviewedAt', null) == null
              && incoming().get('editReviewedBy', null) == null)
          || (request.auth.uid == existing().authorId && incoming().diff(existing()).affectedKeys().hasOnly(['authorName', 'authorAvatar', 'authorUsername', 'isVerified', 'verificationColor', 'updatedAt']))
          || (incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount','updatedAt'])
              && incoming().get('viewsCount', 0) == existing().get('viewsCount', 0) + 1)
          || (incoming().diff(existing()).affectedKeys().hasOnly(['upvotesCount', 'downvotesCount', 'updatedAt']))
          || (incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt']) && (incoming().commentsCount == existing().commentsCount + 1 || incoming().commentsCount == existing().commentsCount - 1))
          || (incoming().diff(existing()).affectedKeys().hasOnly(['repostsCount', 'updatedAt']))
        ));
      allow update: if !isSignedIn()
        && incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount','updatedAt'])
        && incoming().get('viewsCount', 0) == existing().get('viewsCount', 0) + 1
        && incoming().updatedAt is timestamp;
      allow delete: if isSignedIn() && (request.auth.uid == existing().authorId || isAdmin() || isPlatformModerator());
      
      match /comments/{commentId} {
        function isValidComment(data) {
          return data.keys().hasAll(["postId", "authorId", "authorUsername", "content", "createdAt", "updatedAt"])
            && data.postId is string && data.postId == postId
            && data.authorId is string && data.authorId.size() <= 128
            && data.authorUsername is string && data.authorUsername.size() <= 32
            && data.get('authorName', '') is string && data.get('authorName', '').size() <= 64
            && data.get('authorAvatar', '') is string && data.get('authorAvatar', '').size() <= 2048
            && data.get('isVerified', false) is bool
            && data.get('verificationColor', '#2196F3') is string && data.get('verificationColor', '#2196F3').matches('^#[0-9a-fA-F]{6}$')
            && data.content is string && data.content.size() <= 5000
            && data.createdAt is timestamp
            && data.updatedAt is timestamp;
        }

        allow read: if true;
        allow create: if isSignedIn()
          && isValidId(commentId)
          && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBlocked', false)
          && isValidComment(incoming())
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isSignedIn()
          && isValidComment(incoming())
          && (request.auth.uid == existing().authorId || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isVerified', 'verificationColor', 'updatedAt'])))
          && incoming().authorId == existing().authorId
          && incoming().postId == existing().postId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt']) || incoming().diff(existing()).affectedKeys().hasOnly(['authorName', 'authorAvatar', 'authorUsername', 'isVerified', 'verificationColor', 'updatedAt']) || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isVerified', 'verificationColor', 'updatedAt'])));
        allow delete: if isSignedIn() && (request.auth.uid == existing().authorId || isAdmin() || isPlatformModerator());
      }

      match /votes/{userId} {
        allow read: if true;
        allow create, update: if isSignedIn()
          && userId == request.auth.uid
          && incoming().postId == postId
          && incoming().userId == request.auth.uid
          && incoming().type in ['up', 'down'];
        allow delete: if isSignedIn() && (request.auth.uid == userId || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid || isAdmin());
      }

      match /claps/{userId} {
        allow read: if true;
        allow create, update: if isSignedIn()
          && userId == request.auth.uid
          && incoming().postId == postId
          && incoming().userId == request.auth.uid;
        allow delete: if isSignedIn() && (request.auth.uid == userId || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid || isAdmin());
      }

      match /reposts/{userId} {
        allow read: if true;
        allow create: if isSignedIn() && userId == request.auth.uid && incoming().userId == request.auth.uid;
        allow delete: if isSignedIn() && (userId == request.auth.uid || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid || isAdmin());
      }
    }
    

    match /series/{seriesId} {
      allow read: if true;
      match /followers/{userId} {
        allow read: if true;
        allow create: if isSignedIn() && request.auth.uid == userId && incoming().userId == request.auth.uid && incoming().createdAt is timestamp;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
      allow create: if isSignedIn()
        && incoming().ownerId == request.auth.uid
        && incoming().title is string && incoming().title.size() <= 160
        && incoming().slug is string && incoming().slug.size() <= 80
        && incoming().description is string && incoming().description.size() <= 1000
        && incoming().articleCount is number;
      allow update: if isSignedIn()
        && (existing().ownerId == request.auth.uid || isAdmin())
        && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /carousel_slides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteConfigBackups/{backupId} {
      allow read, create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /bento_links/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bento/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /newsletter_subscribers/{subscriberId} {
      allow create: if incoming().email is string && incoming().email.size() <= 256;
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /articles/{slug} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount','updatedAt'])
        && request.resource.data.get('viewsCount', 0) == resource.data.get('viewsCount', 0) + 1
        && request.resource.data.updatedAt is timestamp);

      match /reactions/{userId} {
        allow read: if true;
        allow create, update: if isSignedIn() && request.auth.uid == userId && incoming().userId == request.auth.uid;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && incoming().authorId == request.auth.uid
          && incoming().content is string
          && incoming().content.size() <= 2000;
        allow update: if isSignedIn()
          && (request.auth.uid == existing().authorId || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isVerified', 'verificationColor', 'updatedAt'])))
          && incoming().authorId == existing().authorId
          && (incoming().diff(existing()).affectedKeys().hasOnly(['authorName', 'authorAvatar', 'authorUsername', 'updatedAt', 'content']) || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isVerified', 'verificationColor', 'updatedAt'])));
        allow delete: if isSignedIn() && (request.auth.uid == existing().authorId || isAdmin());
      }
    }


    match /articleViews/{viewId} {
      allow read: if isAdmin();
      allow create: if incoming().slug is string && incoming().day is string && incoming().createdAt is timestamp && ((isSignedIn() && incoming().get('userId','') == request.auth.uid) || (!isSignedIn() && incoming().get('visitorId','') is string));
      allow update, delete: if isAdmin();
    }

    match /articleRevisions/{revisionId} {
      allow read, create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /deleted_articles/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminAuditLog/{eventId} {
      allow read, create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if true;
    }
    // Collection-group read access for profile activity aggregation.
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }


    match /articleLikes/{slug} {
      allow read: if true;
      allow create, update: if isSignedIn();
      
      match /likes/{userId} {
        allow read: if true;
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && incoming().keys().hasAll(["slug", "userId", "createdAt"])
          && incoming().slug is string && incoming().slug == slug
          && incoming().userId is string && incoming().userId == request.auth.uid
          && incoming().createdAt is timestamp;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
