rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Bootstrap owners remain hard-coded so the system cannot lock itself out.
    // Additional master admins are stored in protected Firestore documents.
    function isBootstrapAdmin() {
      return isSignedIn()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') in ['ruizxzxz@gmail.com', 'krishsarkar456@gmail.com'];
    }
    function isConfiguredMasterAdmin() {
      return isSignedIn() && !((siteConfigExists() && get(/databases/$(database)/documents/siteConfig/global).data.get('emergencyAdminLock', false) == true)) && (
        (exists(/databases/$(database)/documents/masterAdmins/$(request.auth.uid))
          && get(/databases/$(database)/documents/masterAdmins/$(request.auth.uid)).data.get('enabled', true) == true)
        || (request.auth.token.get('email_verified', false) == true
          && exists(/databases/$(database)/documents/masterAdminEmails/$(request.auth.token.email))
          && get(/databases/$(database)/documents/masterAdminEmails/$(request.auth.token.email)).data.get('enabled', true) == true)
      );
    }
    function isAdmin() { return isBootstrapAdmin() || isConfiguredMasterAdmin(); }
    function isPlatformModerator() { return isSignedIn() && exists(/databases/$(database)/documents/siteModerators/$(request.auth.uid)) && get(/databases/$(database)/documents/siteModerators/$(request.auth.uid)).data.get('enabled', true) == true; }
    function hasModeratorPermission(permission) { return isSignedIn() && (isAdmin() || (isPlatformModerator() && get(/databases/$(database)/documents/siteModerators/$(request.auth.uid)).data.get('permissions', {}).get(permission, false) == true)); }
    function isStaff() { return isAdmin() || isPlatformModerator(); }
    function siteConfigExists() { return exists(/databases/$(database)/documents/siteConfig/global); }
    function emergencyAdminLock() { return siteConfigExists() && get(/databases/$(database)/documents/siteConfig/global).data.get('emergencyAdminLock', false) == true; }
    function publicBlogsEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('allowPublicBlogs', true) == true; }
    function communityBlogsEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('allowCommunityBlogs', true) == true; }
    function communityDiscussionsEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('allowCommunityDiscussions', true) == true; }
    function communityCreationEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('allowCommunityCreation', true) == true; }
    function communityPostsEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('allowCommunityPosts', true) == true; }
    function questionsEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('allowQuestions', true) == true; }
    function topicsEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('allowTopics', true) == true; }
    function directMessagesEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('allowDirectMessages', true) == true; }
    function commentsEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('commentsEnabled', true) == true; }
    function postingEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('postingEnabled', true) == true; }
    function reactionsEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('reactionsEnabled', true) == true; }
    function followingEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('followingEnabled', true) == true; }
    function registrationsEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('registrationsEnabled', true) == true; }
    function uploadsEnabled() { return !siteConfigExists() || get(/databases/$(database)/documents/siteConfig/global).data.get('uploadsEnabled', true) == true; }
    function readOnlyMode() { return siteConfigExists() && get(/databases/$(database)/documents/siteConfig/global).data.get('readOnlyMode', false) == true; }
    function maintenanceMode() { return siteConfigExists() && get(/databases/$(database)/documents/siteConfig/global).data.get('maintenanceMode', false) == true; }
    function userBlocked(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.get('isBlocked', false) == true; }
    function userRestricted(uid, field) { return get(/databases/$(database)/documents/users/$(uid)).data.get(field, false) == true; }
    function writesClosed() { return readOnlyMode() || maintenanceMode(); }
    function userMayWrite(uid) { return isSignedIn() && !userBlocked(uid) && !userRestricted(uid, 'isSuspended') && !writesClosed(); }
    function userMayComment(uid) { return userMayWrite(uid) && commentsEnabled() && !userRestricted(uid, 'restrictCommenting'); }
    function userMayPost(uid) { return userMayWrite(uid) && postingEnabled() && !userRestricted(uid, 'restrictPosting'); }
    function userMayReact(uid) { return userMayWrite(uid) && reactionsEnabled() && !userRestricted(uid, 'restrictReactions'); }
    function userMayFollow(uid) { return userMayWrite(uid) && followingEnabled() && !userRestricted(uid, 'restrictFollowing'); }
    function userMayCommunity(uid) { return userMayWrite(uid) && !userRestricted(uid, 'restrictCommunities'); }


    match /runtimeErrors/{errorId} {
      allow create: if isSignedIn()
        && incoming().uid == request.auth.uid
        && incoming().message is string
        && incoming().message.size() <= 2000
        && incoming().path is string
        && incoming().path.size() <= 2000
        && incoming().version is string
        && incoming().version.size() <= 32
        && incoming().source is string
        && incoming().source.size() <= 200
        && incoming().createdAt is timestamp;
      allow read: if isAdmin() || isPlatformModerator();
      allow update, delete: if isAdmin();
    }

    // USER VALIDATION
    function validProfileUpdate(next, prev) {
      let changed = next.diff(prev).affectedKeys();
      return
        (!changed.hasAny(["username"]) || (next.get("username", "") is string && next.get("username", "").size() <= 32 && (next.get("username", "") == "" || next.get("username", "").matches("^[a-zA-Z0-9_]+$"))))
        && (!changed.hasAny(["displayName"]) || (next.get("displayName", "") is string && next.get("displayName", "").size() <= 64))
        && (!changed.hasAny(["photoURL"]) || (next.get("photoURL", "") is string && next.get("photoURL", "").size() <= 2048))
        && (!changed.hasAny(["coverImageUrl"]) || (next.get("coverImageUrl", "") is string && next.get("coverImageUrl", "").size() <= 2048))
        && (!changed.hasAny(["websiteUrl"]) || (next.get("websiteUrl", "") is string && next.get("websiteUrl", "").size() <= 512))
        && (!changed.hasAny(["location"]) || (next.get("location", "") is string && next.get("location", "").size() <= 100))
        && (!changed.hasAny(["socialX"]) || (next.get("socialX", "") is string && next.get("socialX", "").size() <= 512))
        && (!changed.hasAny(["socialGithub"]) || (next.get("socialGithub", "") is string && next.get("socialGithub", "").size() <= 512))
        && (!changed.hasAny(["socialTelegram"]) || (next.get("socialTelegram", "") is string && next.get("socialTelegram", "").size() <= 512))
        && (!changed.hasAny(["socialInstagram"]) || (next.get("socialInstagram", "") is string && next.get("socialInstagram", "").size() <= 512))
        && (!changed.hasAny(["bio"]) || (next.get("bio", "") is string && next.get("bio", "").size() <= 500))
        && (!changed.hasAny(["themeColor"]) || (next.get("themeColor", "#000000") is string && next.get("themeColor", "#000000").matches("^#[0-9a-fA-F]{6}$")));
    }

    function isValidUser(data) {
      return data.keys().hasAll(["uid", "username", "displayName", "createdAt", "updatedAt"])
        && data.uid is string && data.uid.size() <= 128
        && data.username is string && data.username.size() <= 32 && (data.username == '' || data.username.matches('^[a-zA-Z0-9_]+$'))
        && data.displayName is string && data.displayName.size() <= 64
        && data.get('photoURL', '') is string && data.get('photoURL', '').size() <= 2048
        && data.get('coverImageUrl', '') is string && data.get('coverImageUrl', '').size() <= 2048
        && data.get('websiteUrl', '') is string && data.get('websiteUrl', '').size() <= 512
        && data.get('location', '') is string && data.get('location', '').size() <= 100
        && data.get('socialX', '') is string && data.get('socialX', '').size() <= 512
        && data.get('socialGithub', '') is string && data.get('socialGithub', '').size() <= 512
        && data.get('socialTelegram', '') is string && data.get('socialTelegram', '').size() <= 512
        && data.get('socialInstagram', '') is string && data.get('socialInstagram', '').size() <= 512
        && data.get('bio', '') is string && data.get('bio', '').size() <= 500
        && data.get('themeColor', '#000000') is string && data.get('themeColor', '#000000').size() <= 7 && data.get('themeColor', '#000000').matches('^#[0-9a-fA-F]{6}$')
        && data.get('followersCount', 0) is number
        && data.get('followingCount', 0) is number
        && data.get('role', '') is string
        && data.get('platformRole', 'member') in ['member','moderator','master_admin']
        && data.get('isBlocked', false) is bool
        && data.get('isSuspended', false) is bool
        && data.get('restrictCommenting', false) is bool
        && data.get('restrictPosting', false) is bool
        && data.get('restrictCommunities', false) is bool
        && data.get('restrictReactions', false) is bool
        && data.get('restrictFollowing', false) is bool
        && data.get('moderatorNote', '') is string && data.get('moderatorNote', '').size() <= 1000
        && data.get('warningCount', 0) is number
        && data.get('suspensionUntil', '') is string && data.get('suspensionUntil', '').size() <= 64
        && data.get('isAuthor', false) is bool
        && data.get('isVerified', false) is bool
        && data.get('verificationColor', '#2196F3') is string && data.get('verificationColor', '#2196F3').matches('^#[0-9a-fA-F]{6}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /siteModerators/{userId} {
      // A moderator must be able to verify their own staff membership.
      // Nobody else gets to enumerate the moderator registry.
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
      allow update: if isSignedIn() && request.auth.uid == userId
        && existing().uid == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['username','displayName','updatedAt']);
    }

    match /presence/{scopeId}/members/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId
        && incoming().uid == request.auth.uid
        && incoming().lastSeenAt is timestamp
        && incoming().expiresAt is timestamp;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Explicit collection-group authorization for privileged diagnostics.
    match /{path=**}/members/{memberId} {
      allow read: if isAdmin();
    }

    // Allow a signed-in user to refresh only their own denormalized identity snapshots across nested collections.
    // The queryable fields mirror the UID used by the document owners, so this cannot expose another user's identity records.
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid && memberId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid && memberId == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['username','updatedAt']);
    }
    match /{path=**}/following/{followingId} {
      allow read: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid && followingId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.get('uid', '') == request.auth.uid && followingId == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['username','updatedAt']);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() 
        && (registrationsEnabled() || isAdmin())
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().get('platformRole', 'member') == (isAdmin() ? 'master_admin' : 'member')
        && incoming().get('role', '') == (isAdmin() ? 'Master Admin' : '')
        && (incoming().username == '' || existsAfter(/databases/$(database)/documents/usernames/$(incoming().username)));
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'photoURL', 'coverImageUrl', 'websiteUrl', 'location', 'socialX', 'socialGithub', 'socialTelegram', 'socialInstagram', 'bio', 'themeColor', 'creatorPage', 'updatedAt'])
        && validProfileUpdate(incoming(), existing())
        && (incoming().get('username', '') == existing().get('username', '')
          || incoming().get('username', '') == ''
          || existsAfter(/databases/$(database)/documents/usernames/$(incoming().get('username', ''))))
        || (isAdmin() && request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'coverImageUrl', 'websiteUrl', 'location', 'socialX', 'socialGithub', 'socialTelegram', 'socialInstagram', 'bio', 'themeColor', 'creatorPage', 'role', 'platformRole', 'isAuthor', 'isVerified', 'verificationColor', 'updatedAt']))
        || (isAdmin() && existing().username == 'krishsarkar' && existing().get('isAuthor', false) == true && incoming().uid == existing().uid && incoming().username == existing().username && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'coverImageUrl', 'websiteUrl', 'location', 'socialX', 'socialGithub', 'socialTelegram', 'socialInstagram', 'bio', 'themeColor', 'creatorPage', 'role', 'platformRole', 'isAuthor', 'isVerified', 'verificationColor', 'followersCount', 'followingCount', 'updatedAt']))
        || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isBlocked', 'isSuspended', 'restrictCommenting', 'restrictPosting', 'restrictCommunities', 'restrictReactions', 'restrictFollowing', 'moderatorNote', 'warningCount', 'suspensionUntil', 'updatedAt']))
        || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isVerified', 'verificationColor', 'updatedAt']))
        || (isAdmin() && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['username','updatedAt'])
          && (incoming().get('username', '') == '' || existsAfter(/databases/$(database)/documents/usernames/$(incoming().get('username', '')))))
        || (isPlatformModerator() && incoming().diff(existing()).affectedKeys().hasOnly(['content','updatedAt']))
        || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['followersCount', 'updatedAt']))
        || (isSignedIn() && request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['followingCount', 'updatedAt']))
        || (isAdmin() && isValidUser(incoming()));
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      match /followers/{followerId} {
        allow read: if true;
        allow create: if userMayFollow(request.auth.uid)
          && request.auth.uid == followerId
          && incoming().keys().hasAll(["createdAt", "uid", "username"])
          && incoming().uid == followerId;
        allow delete: if isSignedIn() && request.auth.uid == followerId;
      }

      match /following/{followingId} {
        allow read: if true;
        allow create: if userMayFollow(request.auth.uid)
          && request.auth.uid == userId
          && incoming().keys().hasAll(["createdAt", "uid", "username"])
          && incoming().uid == followingId;
        allow update: if isSignedIn() && request.auth.uid == followingId && existing().uid == request.auth.uid
          && incoming().uid == existing().uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['username','updatedAt']);
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /followedTopics/{topicId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && request.auth.uid == userId
          && incoming().topic is string && incoming().topic.size() >= 2 && incoming().topic.size() <= 64
          && incoming().createdAt is timestamp;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /followedSeries/{seriesId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && request.auth.uid == userId
          && incoming().seriesId is string && incoming().seriesId.size() >= 1 && incoming().seriesId.size() <= 200
          && incoming().createdAt is timestamp;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /searches/{searchId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId
          && incoming().query is string && incoming().query.size() >= 2 && incoming().query.size() <= 120
          && incoming().createdAt is timestamp;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /reactionIndex/{reactionId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && request.auth.uid == userId
          && incoming().itemId is string && incoming().itemId.size() >= 1 && incoming().itemId.size() <= 512
          && incoming().reaction in ['like','useful','insightful','interesting']
          && incoming().updatedAt is timestamp;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /saves/{saveId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && incoming().keys().hasAll(["itemId", "itemType", "createdAt"])
          && incoming().itemId is string && incoming().itemId.size() <= 128
          && incoming().itemType in ['article', 'post']
          && incoming().createdAt is timestamp;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /history/{historyId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && incoming().slug is string
          && incoming().slug.size() <= 512
          && incoming().title is string
          && incoming().title.size() <= 300
          && incoming().get('progress', 0) is number
          && incoming().get('viewedAt', request.time) is timestamp
        && incoming().get('lastSection', '') is string && incoming().get('lastSection', '').size() <= 200
        && incoming().get('scrollY', 0) is number && incoming().get('scrollY', 0) >= 0
        && incoming().get('viewportHeight', 0) is number && incoming().get('viewportHeight', 0) >= 0 && incoming().get('viewportHeight', 0) <= 20000
        && incoming().get('device', '') is string && incoming().get('device', '').size() <= 120
        && incoming().get('source', 'article') is string && incoming().get('source', 'article').size() <= 80;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Private, account-scoped reading queue. Deterministic document IDs prevent duplicates.
      match /readingQueue/{queueId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && incoming().itemId is string && incoming().itemId.size() <= 512
          && incoming().itemType in ['article', 'post']
          && incoming().title is string && incoming().title.size() <= 300
          && incoming().createdAt is timestamp;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Private account preferences. Only the owning account can read/write these.
      match /preferences/{preferenceId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && request.auth.uid == userId && (
          (preferenceId == 'notifications'
            && incoming().get('comments', true) is bool
            && incoming().get('replies', true) is bool
            && incoming().get('mentions', true) is bool
            && incoming().get('follows', true) is bool
            && incoming().get('reactions', true) is bool
            && incoming().get('productNews', true) is bool)
          || (preferenceId == 'ui' && incoming().get('theme', 'light') in ['light','dark'])
        );
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /upvotes/{postId} {
        allow read: if true;
        allow create, update: if isSignedIn() && request.auth.uid == userId && incoming().postId == postId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /reposts/{postId} {
        allow read: if true;
        allow create, update: if isSignedIn() && request.auth.uid == userId && incoming().postId == postId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }


    // SOCIAL 3.0: unified communities, questions, topics, messaging and moderation.
    function validText(v, max) { return v is string && v.size() <= max; }
    function isCommunityOwner(communityId) {
      return isSignedIn() && get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid;
    }
    function isCommunityModerator(communityId) {
      return isSignedIn() && get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.get('role','member') in ['owner','moderator'];
    }

    match /communities/{communityId} {
      allow read: if true;
      allow create: if userMayCommunity(request.auth.uid) && (isAdmin() || isPlatformModerator() || communityCreationEnabled())
        && incoming().ownerId == request.auth.uid
        && incoming().membersCount == 1
        && incoming().postsCount == 0
        && validText(incoming().name, 60)
        && validText(incoming().slug, 60)
        && validText(incoming().description, 1000);
      allow update: if isSignedIn() && (
        isAdmin() || isPlatformModerator() ||
        (existing().ownerId == request.auth.uid && incoming().ownerId == existing().ownerId && incoming().diff(existing()).affectedKeys().hasOnly(['name','slug','description','iconUrl','bannerUrl','rules','ownerUsername','ownerName','ownerAvatar','isPrivate','isArchived','isLocked','allowLinks','allowMedia','defaultPostType','updatedAt'])) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['membersCount','updatedAt']) && incoming().membersCount >= 0) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['postsCount','updatedAt']) && incoming().postsCount >= 0) ||
        (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['ownerId','ownerUsername','ownerName','ownerAvatar','updatedAt']))
      );
      allow delete: if isSignedIn() && (isAdmin() || isPlatformModerator() || existing().ownerId == request.auth.uid);

      match /members/{memberId} {
        allow read: if true;
        allow create: if isSignedIn() && (request.auth.uid == memberId || isAdmin() || isPlatformModerator() || isCommunityOwner(communityId))
          && incoming().uid == memberId;
        allow update: if isSignedIn() && (
          isAdmin() ||
          isCommunityOwner(communityId) ||
          (isPlatformModerator() && memberId != get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId) ||
          (request.auth.uid == memberId
            && existing().uid == request.auth.uid
            && incoming().uid == existing().uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['username','updatedAt']))
        );
        allow delete: if isSignedIn() && (
          isAdmin() ||
          (isCommunityOwner(communityId) && memberId != get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId) ||
          (isPlatformModerator() && memberId != get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId) ||
          (request.auth.uid == memberId && memberId != get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId)
        );
      }

      match /posts/{postId}/{nestedPath=**} {
        allow read: if true;
        allow delete: if isSignedIn() && (isAdmin() || isPlatformModerator() || isCommunityModerator(communityId) || request.auth.uid == get(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)).data.authorId);
      }

      match /posts/{postId} {
        allow read: if true;
        allow create: if isSignedIn() && (isAdmin() || hasModeratorPermission('moderatePosts') || communityPostsEnabled())
          && incoming().authorId == request.auth.uid
          && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid))
          && validText(incoming().title, 256)
          && validText(incoming().content, 100000)
          && incoming().score == 0
          && incoming().commentsCount == 0
          && incoming().get('isFeatured', false) == false
          && (incoming().get('postType', 'discussion') == 'blog' ? communityBlogsEnabled() : communityDiscussionsEnabled());
        allow update: if isSignedIn() && (
          isAdmin() ||
          hasModeratorPermission('moderatePosts') ||
          isCommunityModerator(communityId) ||
          (request.auth.uid == existing().authorId && (
            existing().get('postType', 'discussion') != 'blog' ||
            (existing().get('promotedToArticleSlug', '') == '' && existing().get('mainPublicationStatus', '') != 'published') ||
            (incoming().get('editReviewStatus', '') == 'pending' && incoming().get('editReviewRequestedAt', null) is timestamp && incoming().get('editReviewedAt', null) == null && incoming().get('editReviewedBy', null) == null)
          ))
          || (request.auth.uid == existing().authorId && incoming().diff(existing()).affectedKeys().hasOnly(['authorName','authorAvatar','authorUsername','isVerified','verificationColor','updatedAt']))
        );
        allow update: if isSignedIn()
          && incoming().diff(existing()).affectedKeys().hasOnly(['poll','updatedAt'])
          && incoming().get('poll', {}).get('question','') == existing().get('poll', {}).get('question','')
          && incoming().get('poll', {}).get('options',[]) == existing().get('poll', {}).get('options',[])
          && getAfter(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)/pollVotes/$(request.auth.uid)).data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)/pollVotes/$(request.auth.uid)).data.optionIndex is number;
        allow update: if !isSignedIn()
          && incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount','updatedAt'])
          && incoming().get('viewsCount', 0) == existing().get('viewsCount', 0) + 1
          && incoming().updatedAt is timestamp;
        allow delete: if isSignedIn() && (isAdmin() || hasModeratorPermission('moderatePosts') || isCommunityModerator(communityId) || request.auth.uid == existing().authorId);
        match /views/{viewId} {
          allow read: if isAdmin();
          allow create: if incoming().postId == postId
            && incoming().day is string
            && incoming().createdAt is timestamp
            && ((isSignedIn() && incoming().get('userId','') == request.auth.uid) || (!isSignedIn() && incoming().get('visitorId','') is string));
          allow update, delete: if isAdmin();
        }
        match /votes/{userId} {
          allow read: if true;
          allow create, update: if isSignedIn() && request.auth.uid == userId && incoming().uid == request.auth.uid && incoming().type in ['up','down'];
          allow delete: if isSignedIn() && (request.auth.uid == userId || isStaff() || isCommunityModerator(communityId));
        }
        match /followers/{userId} {
          allow read: if true;
          allow create: if userMayFollow(request.auth.uid) && request.auth.uid == userId && incoming().userId == userId && incoming().createdAt is timestamp;
          allow delete: if isSignedIn() && request.auth.uid == userId;
        }
        match /pollVotes/{userId} {
          allow read: if true;
          allow create, update: if isSignedIn() && request.auth.uid == userId && incoming().uid == request.auth.uid && incoming().optionIndex is number;
          allow delete: if isSignedIn() && (request.auth.uid == userId || isStaff() || isCommunityModerator(communityId));
        }
        match /comments/{commentId} {
          function validCommunityComment(data) {
            return data.postId is string && data.postId == postId
              && data.authorId is string && data.authorId.size() <= 128
              && data.authorUsername is string && data.authorUsername.size() <= 32
              && data.get('authorName','') is string && data.get('authorName','').size() <= 64
              && data.get('authorAvatar','') is string && data.get('authorAvatar','').size() <= 2048
              && data.content is string && data.content.size() <= 5000
              && data.get('parentId','') is string && data.get('parentId','').size() <= 128
              && data.createdAt is timestamp && data.updatedAt is timestamp
              && (data.get('editedAt', null) == null || data.get('editedAt', null) is timestamp)
              && data.get('mentionedUsernames',[]) is list
              && data.get('isHidden',false) is bool && data.get('isDeleted',false) is bool
              && data.get('likeCount',0) is number;
          }
          allow read: if true;
          allow create: if userMayComment(request.auth.uid) && validCommunityComment(incoming())
            && incoming().authorId == request.auth.uid
            && incoming().createdAt == request.time && incoming().updatedAt == request.time
            && !get(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)).data.get('isLocked',false);
          allow update: if isSignedIn() && validCommunityComment(incoming())
            && incoming().authorId == existing().authorId
            && incoming().postId == existing().postId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && (
              (request.auth.uid == existing().authorId && incoming().diff(existing()).affectedKeys().hasOnly(['content','mentionedUsernames','editedAt','updatedAt']))
              || (isStaff() || isCommunityModerator(communityId)) && incoming().diff(existing()).affectedKeys().hasOnly(['isHidden','isDeleted','moderationReason','updatedAt'])
              || (incoming().diff(existing()).affectedKeys().hasOnly(['likeCount','updatedAt']) && (incoming().likeCount == existing().get('likeCount',0)+1 || incoming().likeCount == existing().get('likeCount',0)-1))
            );
          allow delete: if isSignedIn() && (request.auth.uid == existing().authorId || isStaff() || isCommunityModerator(communityId));
          match /reactions/{userId} {
            allow read: if true;
            allow create: if isSignedIn() && request.auth.uid == userId && incoming().userId == userId && incoming().createdAt is timestamp;
            allow delete: if isSignedIn() && request.auth.uid == userId;
          }
        }
      }
    }

    match /questions/{questionId} {
      allow read: if resource.data.get('moderationState','VISIBLE') == 'VISIBLE' || isStaff();
      allow create: if userMayPost(request.auth.uid) && (isAdmin() || hasModeratorPermission('moderatePosts') || questionsEnabled())
        && incoming().authorId == request.auth.uid
        && validText(incoming().title,256)
        && validText(incoming().details,100000)
        && incoming().answersCount == 0
        && incoming().upvotesCount == 0
        && incoming().followersCount == 0
        && incoming().moderationState == 'VISIBLE'
        && incoming().isAnonymous is bool
        && incoming().topics.size() <= 10;
      allow update: if isStaff();
      // Answer creation/deletion counter update: authenticated author of the atomic answer write.
      allow update: if isSignedIn()
        && incoming().diff(existing()).affectedKeys().hasOnly(['answersCount','lastAnswerId','lastDeletedAnswerId','updatedAt'])
        && (
          (
            incoming().get('answersCount',0) == existing().get('answersCount',0) + 1
            && incoming().get('lastAnswerId','') != ''
            && getAfter(/databases/$(database)/documents/questions/$(questionId)/answers/$(incoming().get('lastAnswerId',''))).data.authorId == request.auth.uid
            && getAfter(/databases/$(database)/documents/questions/$(questionId)/answers/$(incoming().get('lastAnswerId',''))).data.questionId == questionId
          )
          ||
          (
            incoming().get('answersCount',0) == existing().get('answersCount',0) - 1
            && incoming().get('lastDeletedAnswerId','') != ''
            && get(/databases/$(database)/documents/questions/$(questionId)/answers/$(incoming().get('lastDeletedAnswerId',''))).data.authorId == request.auth.uid
            && !existsAfter(/databases/$(database)/documents/questions/$(questionId)/answers/$(incoming().get('lastDeletedAnswerId','')))
          )
        );
      allow update: if isSignedIn() && request.auth.uid == existing().authorId
        && incoming().diff(existing()).affectedKeys().hasOnly(['title','details','topics','attachments','relatedArticleSlug','relatedCommunityId','updatedAt']);
      allow update: if isSignedIn() && request.auth.uid == existing().authorId
        && incoming().diff(existing()).affectedKeys().hasOnly(['authorUsername','authorName','authorAvatar','updatedAt']);
      allow delete: if isStaff() || (isSignedIn() && request.auth.uid == existing().authorId);
      match /answers/{answerId} {
        allow read: if get(/databases/$(database)/documents/questions/$(questionId)).data.get('moderationState','VISIBLE') == 'VISIBLE' || isStaff();
        allow create: if userMayWrite(request.auth.uid) && incoming().authorId == request.auth.uid && validText(incoming().content,100000) && incoming().questionId == questionId && get(/databases/$(database)/documents/questions/$(questionId)).data.get('moderationState','VISIBLE') == 'VISIBLE';
        allow update: if isStaff() || (isSignedIn() && (
          (request.auth.uid == existing().authorId || request.auth.uid == get(/databases/$(database)/documents/questions/$(questionId)).data.authorId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['content','contentBlocks','mediaUrls','parentAnswerId','updatedAt'])
        ));
        // Reply count update paired atomically with creation/deletion of this user's answer.
        allow update: if isSignedIn()
          && incoming().diff(existing()).affectedKeys().hasOnly(['repliesCount','lastReplyId','lastDeletedReplyId','updatedAt'])
          && (
            (
              incoming().get('repliesCount',0) == existing().get('repliesCount',0) + 1
              && incoming().get('lastReplyId','') != ''
              && getAfter(/databases/$(database)/documents/questions/$(questionId)/answers/$(incoming().get('lastReplyId',''))).data.authorId == request.auth.uid
              && getAfter(/databases/$(database)/documents/questions/$(questionId)/answers/$(incoming().get('lastReplyId',''))).data.parentAnswerId == answerId
            )
            ||
            (
              incoming().get('repliesCount',0) == existing().get('repliesCount',0) - 1
              && incoming().get('lastDeletedReplyId','') != ''
              && get(/databases/$(database)/documents/questions/$(questionId)/answers/$(incoming().get('lastDeletedReplyId',''))).data.authorId == request.auth.uid
              && !existsAfter(/databases/$(database)/documents/questions/$(questionId)/answers/$(incoming().get('lastDeletedReplyId','')))
            )
          );
        allow update: if isSignedIn() && request.auth.uid == existing().authorId && incoming().diff(existing()).affectedKeys().hasOnly(['authorUsername','authorName','authorAvatar','updatedAt']);
        allow delete: if isStaff() || (isSignedIn() && (request.auth.uid == existing().authorId || request.auth.uid == get(/databases/$(database)/documents/questions/$(questionId)).data.authorId));
        match /votes/{userId} {
          allow read: if true;
          allow create, update: if isSignedIn() && request.auth.uid == userId && incoming().uid == request.auth.uid && incoming().type in ['up','down'];
          allow delete: if isSignedIn() && request.auth.uid == userId;
        }
      }
      match /questionVotes/{userId} {
        allow read: if true;
        allow create, update: if isSignedIn() && request.auth.uid == userId && incoming().uid == request.auth.uid;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
      match /followers/{userId} {
        allow read: if true;
        allow create: if userMayFollow(request.auth.uid) && request.auth.uid == userId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /topics/{topicId} {
      allow read: if true;
      allow create: if userMayPost(request.auth.uid) && (isAdmin() || hasModeratorPermission('moderatePosts') || topicsEnabled()) && incoming().createdBy == request.auth.uid && validText(incoming().name,80) && validText(incoming().slug,80);
      allow update: if isSignedIn() && (isAdmin() || hasModeratorPermission('moderatePosts') || request.auth.uid == existing().createdBy || incoming().diff(existing()).affectedKeys().hasOnly(['followersCount','updatedAt']) || (request.auth.uid == existing().createdBy && incoming().diff(existing()).affectedKeys().hasOnly(['creatorUsername','updatedAt'])));
      allow delete: if isSignedIn() && (isAdmin() || hasModeratorPermission('moderatePosts') || request.auth.uid == existing().createdBy);
      match /followers/{userId} {
        allow read: if true;
        allow create: if userMayFollow(request.auth.uid) && request.auth.uid == userId;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /messages/{messageId} {
      allow read: if isAdmin() || (isSignedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.recipientId || request.auth.uid in resource.data.get('participants', [])));
      allow create: if userMayWrite(request.auth.uid) && (isAdmin() || hasModeratorPermission('moderatePosts') || directMessagesEnabled()) && request.auth.uid == incoming().senderId && request.auth.uid in incoming().participants && incoming().recipientId in incoming().participants && validText(incoming().content,5000);
      allow update: if isAdmin() || (isSignedIn() && (request.auth.uid == existing().senderId || request.auth.uid == existing().recipientId) && incoming().diff(existing()).affectedKeys().hasOnly(['content','read'])) || (isSignedIn() && request.auth.uid == existing().senderId && incoming().diff(existing()).affectedKeys().hasOnly(['senderUsername','senderName','senderAvatar','updatedAt']));
      allow delete: if isAdmin() || (isSignedIn() && (request.auth.uid == existing().senderId || request.auth.uid == existing().recipientId));
    }

    match /reports/{reportId} {
      allow read: if hasModeratorPermission('manageReports') || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if isSignedIn() && incoming().reporterId == request.auth.uid && validText(incoming().reason,500) && incoming().status == 'open' && validText(incoming().targetType,40) && validText(incoming().targetId,256);
      allow update: if hasModeratorPermission('manageReports') || (isSignedIn() && request.auth.uid == existing().reporterId && incoming().diff(existing()).affectedKeys().hasOnly(['reporterUsername','updatedAt']));
      allow delete: if hasModeratorPermission('manageReports');
    }

    match /changelogEntries/{entryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /siteProblemReports/{reportId} {
      allow create: if isSignedIn()
        && incoming().reporterId == request.auth.uid
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 140
        && incoming().description is string && incoming().description.size() > 0 && incoming().description.size() <= 4000
        && incoming().status == 'NOTED';
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Required for collectionGroup('posts') used by the all-community feed.
    // Community post documents are public already; this enables the collection-group query.
    match /{path=**}/posts/{postId} {
      allow read: if true;
    }

    match /admin_notifications/{notificationId} {
      allow read: if isStaff();
      allow create: if isSignedIn()
        && incoming().actorId == request.auth.uid
        && incoming().message is string && incoming().message.size() <= 500
        && incoming().read is bool
        && incoming().createdAt is timestamp;
      allow update, delete: if isAdmin() || hasModeratorPermission('moderatePosts') || (isSignedIn() && existing().actorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['actorUsername','actorName','actorAvatar','updatedAt']));
    }

    match /users/{userId}/feedPreferences/{prefId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId
        && prefId == "default"
        && incoming().get('mode', 'algorithmic') in ['algorithmic', 'chronological']
        && incoming().get('hiddenContentIds', []).size() <= 100
        && incoming().get('mutedCreators', []).size() <= 100
        && incoming().get('mutedTopics', []).size() <= 100
        && incoming().get('mutedCommunities', []).size() <= 100
        && incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/mutes/{targetUid} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if userMayFollow(request.auth.uid) && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/collections/{collectionId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 50
        && incoming().get('description', '') is string && incoming().get('description', '').size() <= 160
        && incoming().createdAt is timestamp && incoming().updatedAt is timestamp;
      allow update: if isSignedIn() && request.auth.uid == userId
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 50
        && incoming().get('description', '') is string && incoming().get('description', '').size() <= 160
        && incoming().createdAt == existing().createdAt && incoming().updatedAt is timestamp;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow update: if (isSignedIn() && request.auth.uid == userId) || (isSignedIn() && existing().actorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['actorUsername','actorName','actorAvatar','updatedAt']));
      allow create: if isSignedIn()
        && request.resource.data.actorId is string
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.type is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 200
        && request.resource.data.read is bool
        && request.resource.data.createdAt is timestamp;
    }

    match /users/{userId}/drafts/{draftId} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/discussionRead/{postId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId
        && incoming().postId == postId
        && incoming().userId == userId
        && incoming().lastReadReplyId is string
        && incoming().readAt is timestamp;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Per-user announcement seen/dismissed state. Only ever contains seenAt/dismissedAt
    // server timestamps, written via merge from markAnnouncementSeen/dismissAnnouncementForUser.
    match /users/{userId}/announcementState/{announcementId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }


    // Public profile projection. Contains only public identity/presentation fields.
    // It is keyed by the claimed handle, never by the private Firebase UID.
    match /publicProfiles/{username} {
      allow read: if true;
      allow create, update: if isSignedIn() && (
        (request.resource.data.username == username && request.resource.data.username == getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username)
        || isAdmin()
      );
      allow delete: if isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/usernames/$(username)) && get(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid);
    }

    match /handleAliases/{oldUsername} {
      allow read: if true;
      allow create, update: if isAdmin() || (isSignedIn()
        && exists(/databases/$(database)/documents/usernames/$(oldUsername))
        && get(/databases/$(database)/documents/usernames/$(oldUsername)).data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['newUsername','updatedAt'])
        && request.resource.data.newUsername is string
        && request.resource.data.newUsername.size() >= 3
        && request.resource.data.newUsername.size() <= 30);
      allow delete: if isAdmin();
    }

    match /usernames/{username} {
      allow read: if true;
      allow update: if isSignedIn()
        && existing().uid == request.auth.uid
        && incoming().uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow create: if isSignedIn()
        && incoming().keys().hasAll(["uid"]) && incoming().keys().size() == 1
        && incoming().uid is string && incoming().uid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow delete: if isSignedIn()
        && existing().uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username != username;
    }

    // Private resume point for an authenticated reader. This is deliberately
    // separate from a community profile, so Google accounts do not need to
    // claim a username before Continue Reading works.
    match /reading_progress/{userId} {
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Device-independent article reading checkpoints. One document per article per user.
    match /users/{userId}/readingProgress/{articleSlug} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId
        && incoming().slug == articleSlug
        && incoming().percent is number && incoming().percent >= 0 && incoming().percent <= 100
        && incoming().completed is bool
        && incoming().updatedAt is timestamp
        && incoming().get('lastSection', '') is string && incoming().get('lastSection', '').size() <= 200
        && incoming().get('scrollY', 0) is number && incoming().get('scrollY', 0) >= 0
        && incoming().get('viewportHeight', 0) is number && incoming().get('viewportHeight', 0) >= 0 && incoming().get('viewportHeight', 0) <= 20000
        && incoming().get('device', '') is string && incoming().get('device', '').size() <= 120
        && incoming().get('source', 'article') is string && incoming().get('source', 'article').size() <= 80
        && incoming().get('seriesId', '') is string && incoming().get('seriesId', '').size() <= 200
        && incoming().get('seriesOrder', 0) is number;
      allow update: if isSignedIn() && request.auth.uid == userId
        && incoming().slug == existing().slug
        && incoming().percent is number && incoming().percent >= 0 && incoming().percent <= 100
        && incoming().completed is bool
        && !(existing().completed == true && incoming().completed == false)
        && incoming().updatedAt is timestamp
        && incoming().diff(existing()).affectedKeys().hasOnly(['slug','percent','completed','lastSection','scrollY','viewportHeight','device','source','seriesId','seriesOrder','updatedAt']);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // POST VALIDATION
    function isValidPost(data) {
      return data.keys().hasAll(["type", "title", "content", "authorId", "authorUsername", "upvotesCount", "downvotesCount", "commentsCount", "createdAt", "updatedAt"])
        && data.type is string && (data.type == 'discussion' || data.type == 'blog')
        && data.title is string && data.title.size() <= 256
        && data.content is string && data.content.size() <= 100000
        && data.authorId is string && data.authorId.size() <= 128
        && data.authorUsername is string && data.authorUsername.size() <= 32
        && data.get('authorName', '') is string && data.get('authorName', '').size() <= 64
        && data.get('authorAvatar', '') is string && data.get('authorAvatar', '').size() <= 2048
        && data.get('isVerified', false) is bool
        && data.get('verificationColor', '#2196F3') is string && data.get('verificationColor', '#2196F3').matches('^#[0-9a-fA-F]{6}$')
        && data.upvotesCount is number
        && data.downvotesCount is number
        && data.commentsCount is number
        && data.get('viewsCount', 0) is number
        && data.get('isFeatured', false) is bool
        && data.get('repostsCount', 0) is number
        && data.get('hashtags', []) is list
        && data.get('hashtags', []).size() <= 20
        && data.get('mediaUrls', []) is list
        && data.get('mediaUrls', []).size() <= 6
        && data.get('excerpt', '') is string && data.get('excerpt', '').size() <= 500
        && data.get('coverImage', '') is string && data.get('coverImage', '').size() <= 2048
        && data.get('coverImageAlt', '') is string && data.get('coverImageAlt', '').size() <= 200
        && data.get('coverImageCaption', '') is string && data.get('coverImageCaption', '').size() <= 300
        && data.get('category', '') is string && data.get('category', '').size() <= 80
        && data.get('tags', []) is list && data.get('tags', []).size() <= 20
        && data.get('contentBlocks', []) is list && data.get('contentBlocks', []).size() <= 100
        && data.get('readingTimeMinutes', 1) is number && data.get('readingTimeMinutes', 1) >= 1 && data.get('readingTimeMinutes', 1) <= 180
        && data.get('promotedToArticleSlug', '') is string && data.get('promotedToArticleSlug', '').size() <= 150
        && (data.get('editedAt', null) == null || data.get('editedAt', null) is timestamp)
        && data.get('editReviewStatus', 'approved') in ['pending', 'approved']
        && (data.get('editReviewRequestedAt', null) == null || data.get('editReviewRequestedAt', null) is timestamp)
        && (data.get('editReviewedAt', null) == null || data.get('editReviewedAt', null) is timestamp)
        && (data.get('editReviewedBy', null) == null || (data.get('editReviewedBy', '') is string && data.get('editReviewedBy', '').size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if userMayPost(request.auth.uid)
        && isValidId(postId)
        && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBlocked', false)
        && isValidPost(incoming())
        && incoming().authorId == request.auth.uid
        && (incoming().type == 'blog' ? publicBlogsEnabled() : communityDiscussionsEnabled())
        && incoming().upvotesCount == 0
        && incoming().downvotesCount == 0
        && incoming().commentsCount == 0
        && incoming().get('isFeatured', false) == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if (isSignedIn()
        && isValidPost(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || hasModeratorPermission('moderatePosts')
          || (request.auth.uid == existing().authorId
              && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'hashtags', 'mentionedUsernames', 'mediaUrls', 'excerpt', 'coverImage', 'coverImageAlt', 'coverImageCaption', 'category', 'tags', 'readingTimeMinutes', 'contentBlocks', 'seriesId', 'seriesName', 'seriesOrder', 'editedAt', 'updatedAt'])
              && existing().get('promotedToArticleSlug', '') == ''
              && existing().get('mainPublicationStatus', '') != 'published')
          || (request.auth.uid == existing().authorId
              && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'hashtags', 'mentionedUsernames', 'mediaUrls', 'excerpt', 'coverImage', 'coverImageAlt', 'coverImageCaption', 'category', 'tags', 'readingTimeMinutes', 'contentBlocks', 'seriesId', 'seriesName', 'seriesOrder', 'editedAt', 'updatedAt', 'editReviewStatus', 'editReviewRequestedAt', 'editReviewedAt', 'editReviewedBy'])
              && (existing().get('promotedToArticleSlug', '') != '' || existing().get('mainPublicationStatus', '') == 'published')
              && incoming().get('editReviewStatus', '') == 'pending'
              && incoming().get('editReviewRequestedAt', null) is timestamp
              && incoming().get('editReviewedAt', null) == null
              && incoming().get('editReviewedBy', null) == null)
          || (request.auth.uid == existing().authorId && incoming().diff(existing()).affectedKeys().hasOnly(['authorName', 'authorAvatar', 'authorUsername', 'isVerified', 'verificationColor', 'updatedAt']))
          || (incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount','updatedAt'])
              && incoming().get('viewsCount', 0) == existing().get('viewsCount', 0) + 1)
          || (incoming().diff(existing()).affectedKeys().hasOnly(['upvotesCount', 'downvotesCount', 'updatedAt']))
          || (incoming().diff(existing()).affectedKeys().hasOnly(['commentsCount', 'updatedAt']) && (incoming().commentsCount == existing().commentsCount + 1 || incoming().commentsCount == existing().commentsCount - 1))
          || (incoming().diff(existing()).affectedKeys().hasOnly(['repostsCount', 'updatedAt']))
        ));
      // Poll voting is an atomic user-scoped write: the vote document must be
      // created/updated in the same batch as the post counter update.
      allow update: if isSignedIn()
        && incoming().diff(existing()).affectedKeys().hasOnly(['poll','updatedAt'])
        && incoming().get('poll', {}).get('question','') == existing().get('poll', {}).get('question','')
        && incoming().get('poll', {}).get('options',[]) == existing().get('poll', {}).get('options',[])
        && getAfter(/databases/$(database)/documents/posts/$(postId)/pollVotes/$(request.auth.uid)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/posts/$(postId)/pollVotes/$(request.auth.uid)).data.optionIndex is number;
      allow update: if !isSignedIn()
        && incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount','updatedAt'])
        && incoming().get('viewsCount', 0) == existing().get('viewsCount', 0) + 1
        && incoming().updatedAt is timestamp;
      allow delete: if isSignedIn() && (request.auth.uid == existing().authorId || isAdmin() || hasModeratorPermission('moderatePosts'));
      match /pollVotes/{userId} {
        allow read: if true;
        allow create, update: if isSignedIn() && request.auth.uid == userId && incoming().uid == request.auth.uid && incoming().optionIndex is number;
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin() || hasModeratorPermission('moderatePosts'));
      }
      
      match /comments/{commentId} {
        function isValidComment(data) {
          return data.keys().hasAll(["postId", "authorId", "authorUsername", "content", "createdAt", "updatedAt"])
            && data.postId is string && data.postId == postId
            && data.authorId is string && data.authorId.size() <= 128
            && data.authorUsername is string && data.authorUsername.size() <= 32
            && data.get('authorName', '') is string && data.get('authorName', '').size() <= 64
            && data.get('authorAvatar', '') is string && data.get('authorAvatar', '').size() <= 2048
            && data.get('isVerified', false) is bool
            && data.get('verificationColor', '#2196F3') is string && data.get('verificationColor', '#2196F3').matches('^#[0-9a-fA-F]{6}$')
            && data.content is string && data.content.size() <= 5000
            && data.createdAt is timestamp
            && data.updatedAt is timestamp
            && data.get('isHidden', false) is bool
            && data.get('isDeleted', false) is bool;
        }

        allow read: if true;
        allow create: if userMayComment(request.auth.uid)
          && isValidId(commentId)
          && isValidComment(incoming())
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && !get(/databases/$(database)/documents/posts/$(postId)).data.get('commentsLocked', false);
        allow update: if isSignedIn()
          && isValidComment(incoming())
          && (request.auth.uid == existing().authorId || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isVerified', 'verificationColor', 'updatedAt'])) || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isHidden','isDeleted','content','moderationReason','updatedAt'])))
          && incoming().authorId == existing().authorId
          && incoming().postId == existing().postId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (incoming().diff(existing()).affectedKeys().hasOnly(['content', 'mentionedUsernames', 'editedAt', 'updatedAt']) || incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt']) || incoming().diff(existing()).affectedKeys().hasOnly(['authorName', 'authorAvatar', 'authorUsername', 'isVerified', 'verificationColor', 'updatedAt']) || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isVerified', 'verificationColor', 'updatedAt'])) || (incoming().diff(existing()).affectedKeys().hasOnly(['likeCount','updatedAt']) && (incoming().likeCount == existing().get('likeCount',0)+1 || incoming().likeCount == existing().get('likeCount',0)-1)));
        allow delete: if isSignedIn() && (request.auth.uid == existing().authorId || isAdmin() || hasModeratorPermission('moderatePosts'));
      }

      match /votes/{userId} {
        allow read: if true;
        allow create, update: if userMayReact(request.auth.uid)
          && userId == request.auth.uid
          && incoming().postId == postId
          && incoming().userId == request.auth.uid
          && incoming().type in ['up', 'down'];
        allow delete: if isSignedIn() && (request.auth.uid == userId || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid || isAdmin());
      }

      match /followers/{userId} {
        allow read: if true;
        allow create: if isSignedIn() && request.auth.uid == userId && incoming().userId == userId && incoming().createdAt is timestamp;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
      match /comments/{commentId}/reactions/{userId} {
        allow read: if true;
        allow create: if isSignedIn() && request.auth.uid == userId && incoming().userId == userId && incoming().createdAt is timestamp;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
      match /claps/{userId} {
        allow read: if true;
        allow create, update: if userMayReact(request.auth.uid)
          && userId == request.auth.uid
          && incoming().postId == postId
          && incoming().userId == request.auth.uid;
        allow delete: if isSignedIn() && (request.auth.uid == userId || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid || isAdmin());
      }

      match /reposts/{userId} {
        allow read: if true;
        allow create: if userMayReact(request.auth.uid) && userId == request.auth.uid && incoming().userId == request.auth.uid;
        allow delete: if isSignedIn() && (userId == request.auth.uid || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid || isAdmin());
      }
    }
    

    match /series/{seriesId} {
      allow read: if true;
      match /followers/{userId} {
        allow read: if true;
        allow create: if userMayFollow(request.auth.uid) && request.auth.uid == userId && incoming().userId == request.auth.uid && incoming().createdAt is timestamp;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
      allow create: if isSignedIn()
        && incoming().ownerId == request.auth.uid
        && incoming().title is string && incoming().title.size() <= 160
        && incoming().slug is string && incoming().slug.size() <= 80
        && incoming().description is string && incoming().description.size() <= 1000
        && incoming().articleCount is number;
      allow update: if isSignedIn()
        && (existing().ownerId == request.auth.uid || isAdmin())
        && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /carousel_slides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /masterAdmins/{userId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /masterAdminEmails/{email} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin()
        && email is string && email.size() <= 320;
    }

    match /site_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteConfig/{docId} {
      allow read: if true;
      allow create: if isAdmin() && (isBootstrapAdmin() || incoming().get('emergencyAdminLock', false) == false);
      allow update: if isBootstrapAdmin() || (isAdmin() && !emergencyAdminLock());
      allow delete: if isBootstrapAdmin();
    }

    match /siteConfigBackups/{backupId} {
      allow read, create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /bento_links/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bento/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /newsletter_subscribers/{subscriberId} {
      allow create: if incoming().email is string && incoming().email.size() <= 256;
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /articles/{slug} {
      allow read: if true;
      allow create: if isAdmin() || hasModeratorPermission('editArticles');
      allow delete: if isAdmin() || hasModeratorPermission('deleteArticles');
      allow update: if isAdmin() || hasModeratorPermission('editArticles') || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount','updatedAt'])
        && request.resource.data.get('viewsCount', 0) == resource.data.get('viewsCount', 0) + 1
        && request.resource.data.updatedAt is timestamp)
        || (isSignedIn() && resource.data.get('author', {}).get('uid', '') == request.auth.uid
          && request.resource.data.get('author', {}).get('uid', '') == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['author','authorUsername','authorName','authorAvatar','updatedAt']));

      match /reactions/{userId} {
        allow read: if true;
        allow create, update: if userMayReact(request.auth.uid) && request.auth.uid == userId && incoming().userId == request.auth.uid;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
      match /comments/{commentId} {
        function validArticleComment(data) {
          return data.authorId is string && data.authorId.size() <= 128
            && data.content is string && data.content.size() <= 2000
            && data.createdAt is timestamp
            && data.updatedAt is timestamp
            && data.get('parentId','') is string && data.get('parentId','').size() <= 128
            && data.get('mentionedUsernames',[]) is list
            && data.get('isHidden',false) is bool
            && data.get('isDeleted',false) is bool;
        }
        allow read: if true;
        allow create: if userMayComment(request.auth.uid)
          && !get(/databases/$(database)/documents/articles/$(slug)).data.get('commentsLocked', false)
          && validArticleComment(incoming())
          && incoming().authorId == request.auth.uid
          && incoming().createdAt == request.time && incoming().updatedAt == request.time;
        allow update: if isSignedIn() && validArticleComment(incoming())
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && ((request.auth.uid == existing().authorId && incoming().diff(existing()).affectedKeys().hasOnly(['content','updatedAt','mentionedUsernames','editedAt']))
            || (hasModeratorPermission('moderateComments') && incoming().diff(existing()).affectedKeys().hasOnly(['isHidden','moderationReason','updatedAt']))
            || (request.auth.uid == existing().authorId && incoming().diff(existing()).affectedKeys().hasOnly(['authorName','authorAvatar','authorUsername','isVerified','verificationColor','updatedAt']))
            || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['authorName','authorAvatar','authorUsername','isVerified','verificationColor','updatedAt']))
            || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted','content','updatedAt']))
            || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['likeCount','updatedAt']) && (incoming().likeCount == existing().get('likeCount',0) + 1 || incoming().likeCount == existing().get('likeCount',0) - 1)));
        allow delete: if isSignedIn() && (request.auth.uid == existing().authorId || hasModeratorPermission('moderateComments'));
        match /reactions/{userId} {
          allow read: if true;
          allow create, update: if userMayReact(request.auth.uid) && request.auth.uid == userId && incoming().userId == request.auth.uid;
          allow delete: if isSignedIn() && request.auth.uid == userId;
        }
      }
    }


    // Collection-group analytics access for master/admin reporting.
    match /{path=**}/analytics/{eventId} {
      allow read: if isAdmin();
    }

    match /articles/{slug}/analytics/{eventId} {
      function canReadAnalytics() {
        return isAdmin()
          || hasModeratorPermission('viewAnalytics')
          || (isSignedIn() && get(/databases/$(database)/documents/articles/$(slug)).data.get('author', {}).get('uid', '') == request.auth.uid);
      }
      function validAnalyticsIdentity(data) {
        return data.get('userId', '') is string
          && data.get('visitorId', '') is string
          && (
            data.get('userId', '') == ''
            || (isSignedIn() && data.get('userId', '') == request.auth.uid)
          );
      }
      function validAnalyticsShape(data) {
        return data.slug == slug
          && data.type in ['session', 'share', 'bookmark', 'reaction', 'complete']
          && validAnalyticsIdentity(data);
      }

      allow read: if canReadAnalytics();

      allow create: if validAnalyticsShape(incoming())
        && (
          (
            incoming().type == 'session'
            && incoming().createdAt == request.time
            && incoming().openedAt == request.time
            && incoming().lastSeenAt == request.time
          )
          ||
          (
            incoming().type in ['share', 'bookmark', 'reaction', 'complete']
            && incoming().createdAt == request.time
          )
        );

      allow update: if validAnalyticsShape(incoming())
        && existing().type == 'session'
        && incoming().type == 'session'
        && incoming().slug == existing().slug
        && incoming().get('userId', '') == existing().get('userId', '')
        && incoming().get('visitorId', '') == existing().get('visitorId', '')
        && incoming().lastSeenAt is timestamp
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'lastSeenAt', 'maxScrollPercent', 'durationMs', 'completed',
          'currentSection', 'scrollY', 'seriesId', 'seriesOrder', 'device', 'source'
        ]);

      allow delete: if isAdmin();
    }

    match /articleViews/{viewId} {
      allow read: if isAdmin();
      allow create: if incoming().slug is string && incoming().day is string && incoming().createdAt is timestamp && ((isSignedIn() && incoming().get('userId','') == request.auth.uid) || (!isSignedIn() && incoming().get('visitorId','') is string));
      allow update, delete: if isAdmin();
    }

    match /articleRevisions/{revisionId} {
      allow read, create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /deleted_articles/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminAuditLog/{eventId} {
      allow read, create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if true;
    }
    match /communities/{communityId}/posts/{postId}/comments/{commentId} {
      allow read: if true;
      allow update: if isAdmin() || hasModeratorPermission('moderateComments')
        || (isSignedIn() && existing().authorId == request.auth.uid
          && incoming().authorId == existing().authorId
          && incoming().diff(existing()).affectedKeys().hasOnly(['authorName','authorAvatar','authorUsername','isVerified','verificationColor','updatedAt']));
      allow delete: if isAdmin() || hasModeratorPermission('moderateComments');
    }

    // Collection-group read access for profile activity aggregation.
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }


    match /articleLikes/{slug} {
      allow read: if true;
      allow create, update: if isSignedIn();
      
      match /likes/{userId} {
        allow read: if true;
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && incoming().keys().hasAll(["slug", "userId", "createdAt"])
          && incoming().slug is string && incoming().slug == slug
          && incoming().userId is string && incoming().userId == request.auth.uid
          && incoming().createdAt is timestamp;
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
